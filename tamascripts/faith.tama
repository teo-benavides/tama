main
    # fire 60 pairs of bullets in a circle.
    # bullets in a pair go in opposite directions
    repeat
        # fire a first bullet to set direction reference for the rest
        # 6 is 1/60th of 360
        fire
            dir abs lerpf(0.0, 6.0, randf())
            spd abs 100
            bul b(1)
        # fire second bullet to have it paired with the first
        fire f(-1)
        # fire the other 59 pairs
        repeat 59
            fire f(1)
            fire f(-1)
        wait lerpf(1.0, 1.2, randf())

fire f(direction)
    dir seq 360/60
    spd abs 100
    bullet b(direction)

bul b(direction)
    act
        wait 0.5
        chdir
            dir rel 90 * direction
            over 3.0
