main
    repeat
        fire
            dir seq 360/32
            spd 200
            bullet
                type example
                act e
        waitf 2

act e
    waitf randi_range(30, 45)
    repeat 8*get_1_in(32) i
        fire
            dir abs (360/8)*i
            spd 100
            bullet
                type example
    vanish