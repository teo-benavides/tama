main
    repeat
        fire
            dir seq 360/32
            spd 200
            bullet
                type example
                act e
        waitf 2

act e
    waitf randi_range(30, 45)
    repeat (8 * (1 if randi() % 32 == 0 else 0)) i
        fire
            dir abs (360/8)*i
            spd 100
            bullet
                type example
    vanish