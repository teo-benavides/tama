fire simpleFire(proj, dir_type, spd_type)
    dir dir_type 0
    spd spd_type 200
    bullet proj
    
bullet myBullet(chspd_val)
   type example
   act
       wait 1.0
       chspd
           spd chspd_val
           over 1.0
         
main
    repeat
        fire simpleFire(myBullet(500), aim, abs)
        wait 0.5