fire simpleFire(proj, dir_type, spd_type)
    dir dir_type 0
    spd spd_type 200
    bullet proj

bullet myBullet(accel_val, accel_type, emt_)
   emt emt_

main
    repeat
        fire simpleFire(myBullet(500, abs, simpleEmitter(200)), abs, abs)
        wait 0.5

act simpleEmitter(spd_)
    repeat
        wait 0.5
        fire
            dir aim 0
            spd spd_
