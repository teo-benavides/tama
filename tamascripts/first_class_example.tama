fire simpleFire(proj, dir_type, spd_type)
    dir dir_type 0
    spd spd_type 200
    bullet proj
    
bullet myBullet(accel_val, accel_type)
   type example
   act
       wait 1.0
       accel
           x accel_type accel_val
           y accel_type accel_val
           over 1.0
         
main
    repeat
        fire simpleFire(myBullet(500, abs), aim, abs)
        wait 0.5