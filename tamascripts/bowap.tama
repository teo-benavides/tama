main
    # we fire a separate bullet because we need it to chdir
    fire
        dir abs 0
        speed abs 0
        bullet shooter

fire bwp(direction)
    dir rel direction
    speed abs 250
    bullet
        type example

bullet shooter
    type example
    act
        repeat
            repeat 8 i
                fire bwp((360/8) * i)
            chdir
                dir rel time()*4
                over 0
            wait 0.07
