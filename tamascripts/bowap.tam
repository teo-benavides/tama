main
    fire
        dir abs 0
        speed abs 0
        bullet shooter

fire bwp(direction)
    dir rel direction
    speed abs 250
    offset
        x abs 0
        y abs 0

act shoot
    fire bwp((360/8) * 1)
    fire bwp((360/8) * 2)
    fire bwp((360/8) * 3)
    fire bwp((360/8) * 4)
    fire bwp((360/8) * 5)
    fire bwp((360/8) * 6)
    fire bwp((360/8) * 7)
    fire bwp((360/8) * 8)

bullet shooter
    type shooter
    act
        repeat
            act shoot
            chdir
                dir rel time()*4
                over 0
            wait 0.07
