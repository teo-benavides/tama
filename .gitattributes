# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf

# Only include the addons folder when downloading from the Asset Library.
/**        export-ignore
/addons    !export-ignore
/addons/** !export-ignore

# Exclude C++ source, build scripts, godot-cpp submodule, and doc XML —
# users only need the compiled binaries in bin/.
/addons/tama/native export-ignore