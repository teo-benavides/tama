main
    fire
        dir abs 0
        spd abs 0
        offset
            x rel -130
            y rel 0
        bullet shooter(90-20, 100)
    fire
        dir abs 0
        spd abs 0
        offset
            x rel 130
            y rel 0
        bullet shooter(90+20, 200)
    fire
        dir abs 0
        spd abs 0
        offset
            x rel -90
            y rel 60
        bullet shooter(90-20, 300)
    fire
        dir abs 0
        spd abs 0
        offset
            x rel 90
            y rel 60
        bullet shooter(90+20, 400)
    var shots_fired 0
    var ofs 0
    repeat
        if shots_fired >= 5 && get_1_in(5)
            if ofs > 0
                ofs randf_range(-2, -1)
            else
                ofs randf_range(1, 2)
            shots_fired 0
        act spread_shot(15, 80, 90+ofs, 200, fast, abs)
        shots_fired shots_fired + 1
        waitf 10

bullet shooter(wiggle_center, ofs)
    act
        async act wiggle(wiggle_center, ofs)
        async act shoot

act spread_shot(amount, spread, angle, spd_, btype, dirtype)
    repeat amount i
        fire
            dir dirtype (2*i + 1 - amount) * spread / (2 * maxf(amount - 1, 1)) + angle
            spd spd_
            bul
                type btype

act wiggle(center, ofs)
    repeatf
        chdir
            dir aim 5*sin(time()*15+ofs)

act shoot
    repeat
        act spread_shot(8, 200, 0, 1000, blue, rel)
        waitf 2