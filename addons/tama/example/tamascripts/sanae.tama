main
    var amt = 10.0
    var shift_angle = 144
    var shot_angle = 360/10*-3
    repeat amt i
        if i % 2
            shift_angle = 144
            shot_angle = 360/10*-3
        else
            shift_angle = -144
            shot_angle = (360/10*-3)+36 # 180 - 144 = 36
        fire
            dir abs shot_angle # rotate to make it an inverted star
            spd abs 1000
            bul star_spawner((360.0/amt)*i, shift_angle, shot_angle)

bullet star_spawner(move_direction, shift_angle, shot_angle)
    act
        var base_delay = 0
        var arms = 5
        var b_per_arm = 10
        var shot_intervalf = 1
        var base_angle = shot_angle
        var curr_angle = shot_angle
        repeat arms j
            repeat b_per_arm i
                fire
                    dir abs 0
                    spd abs 0
                    bul star_bullet(base_delay+f2s((b_per_arm-1-i)*shot_intervalf+(arms-1-j)*shot_intervalf*b_per_arm), move_direction, curr_angle+i*4)
                waitf shot_intervalf
            chdir
                dir rel shift_angle
            curr_angle = curr_angle + shift_angle
        vanish

bullet star_bullet(delay, move_direction, unfold_direction)
    act
        wait delay
        chdir
            dir abs move_direction
        chspd
            spd abs 300
        chspd
            spd abs 0
            over 1.0
        wait 2.0
        chdir
            dir abs unfold_direction
        chspd
            spd abs 100
            over 2.0