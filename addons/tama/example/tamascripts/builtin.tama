act x_way(x_, spin, spd_, offset_)
    fire
        dir abs -90 + spin
        spd spd_
        offset offset_
    repeat x_-1 i
        fire
            dir seq 360/x_
            spd spd_
            offset offset_
            
act spiral(steps, interval, spd_, offset_)
    repeat
        fire
            dir seq 360/steps
            spd spd_
            offset offset_
        wait interval

act aimed_shots(amount, spread, spd_, bullet_type)
    repeat amount i
        fire
            dir aim (2*i + 1 - amount) * spread / (2 * maxf(amount - 1, 1))
            spd spd_
            bul
                type bullet_type

act act_every(seconds, act_)
    repeat
        act act_
        wait seconds

act act_everyf(frames, act_)
    repeat
        act act_
        waitf frames

act fire_every(seconds, fire_)
    repeat
        fire fire_
        wait seconds

act fire_everyf(frames, fire_)
    repeat
        fire fire_
        waitf frames

act multishot(amount, spread, interval, angle, dirtype, speed_, iterations)
    repeat iterations
        repeat amount i
            fire
                dir dirtype (2*i + 1 - amount) * spread / (2 * maxi(amount - 1, 1)) + angle
                spd speed_
        wait interval