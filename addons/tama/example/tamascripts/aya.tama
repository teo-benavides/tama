main
    var amt_ = 12.0
    var ofs = 0.0
    repeat
        repeat 5 j
            repeat amt_ i
                fire f(20, (2.0 * PI * i / amt_), (360.0/5)*j+ofs)
        ofs = ofs + 10
        wait 0.15

fire f(radius, ofs, direction)
    dir abs direction
    spd abs 400
    pos
        x rel radius * cos(ofs)
        y rel radius * sin(ofs)