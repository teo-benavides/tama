main
    act sun

act sun
    repeat
        act circle(50, 50, 0, randf_range(0.0, 5.0))
        waitf 1
    
act circle(amt, spd_, posx, ofs)
    repeat amt i
        fire
            dir abs (360.0/amt) * i + ofs
            spd spd_
            pos
                x rel posx
            bul
                type fast
