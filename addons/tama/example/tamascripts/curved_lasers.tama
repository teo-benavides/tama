main
    repeat
        repeat 8 i
            fire
                dir aim (360/8)*i
                spd abs 400
                rotspd 720
                bul
                    type curvy
                    act
                        wait 0.5
                        chrotspd
                            rotspd 0.0
                        repeat -1 i
                            var direction 1
                            if i % 2
                                direction 1
                            else
                                direction -1
                            chdir
                                dir rel 90*direction
                                over 0.2
                            wait 0.2
        wait 3.0