main
    repeat
        repeat 15 i
            fire
                dir abs -(360/44)*i
                spd abs 300
                bul laser(1)
        wait 0.5
        repeat 15 i
            fire
                dir abs 180+(360/44)*i
                spd abs 300
                bul laser(-1)
        wait 0.5
        form down_lasers(1, 70)
        form down_lasers(-1, 110)
        wait 3.0

bul laser(direction)
    type curvy
    act
        repeatf 60
            chdir
                dir rel 3*direction
        chspd
            spd 20
            over 0.25
        wait 0.25
        chspd
            spd 300
            over 0.5

bul laser_down(direction)
    type curvy
    act
        chrotspd
            rotspd abs 160*direction
        chspd
            spd abs 100
            over 1.0
        wait 1.0
        chspd
            spd abs 300
            over 0.5
        wait 0.7
        chrotspd
            rotspd abs 0
        
form down_lasers(direction, angle)
    type fan
    dir abs angle
    spd abs 300
    spr 90
    amt 9
    bul laser_down(direction)