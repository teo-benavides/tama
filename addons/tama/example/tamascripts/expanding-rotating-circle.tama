main
    repeat
        repeat 60 i
            fire f(0, (2.0 * PI * i / 60.0), time(), 160, 1, 1)
        wait 1.0

fire f(radius, ofs, t0, exp_spd, rot_spd, rot_dir)
    dir abs 0
    spd 0
    pos
        x rel radius * cos(ofs)
        y rel radius * sin(ofs)
    bullet orbiter(radius, ofs, t0, exp_spd, rot_spd, rot_dir)

bullet orbiter(radius, ofs, t0, exp_spd, rot_spd, rot_dir)
    type fast
    mvmt
        x abs spiral_x(spawn_x, radius, ofs, exp_spd, rot_spd, rot_dir, t0)
        y abs spiral_y(spawn_y, radius, ofs, exp_spd, rot_spd, rot_dir, t0)