main
    repeat -1 i
        form samidare(i, fast, 0)
        form samidare(i, orange, 90+(360.0/32.0)/2)
        form samidare(i, blue, 180)
        form samidare(i, green, 270+(360.0/32.0)/2)
        waitf 3

form samidare(inc, btype, ofs)
    type fan
    amt 7
    step 360.0/32.0
    dir abs (inc + 3) * (360.0/32.0) + ofs
    spd 500
    bul
        type btype